{
  "pluginAlias": "IntexPlusPlatform",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Intex"
      },
      "ips": {
        "title": "Comma-separated list of SPA IPs (min. 1)",
        "type": "string",
        "required": true,
        "placeholder": "e.g. 192.168.1.123,192.168.1.124"
      },
      "showUnusedSwitches": {
        "title": "Show unused switches",
        "type": "boolean",
        "default": false
      }
    }
  }
}